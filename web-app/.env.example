# Copy to .env.local and fill in values from the Supabase dashboard (Project Settings > API).
# Never commit real values. Vercel holds the deployed values.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never import into client components or expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Comma-separated emails of people who run the service and may mark manual deposits
# paid at /ops/deposits. Leave empty to disable that page.
OPERATOR_EMAILS=
